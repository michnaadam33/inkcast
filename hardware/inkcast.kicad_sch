	(text "Cycle: TPL5110 turns on DRV -> Pico W boots, measures, uploads data, refreshes the e-Paper,\nthen pulses GP16 (DONE) -> TPL5110 cuts power until the next cycle.\nThe battery is charged over USB-C (DFR0668); the TPL5110 is powered directly from the battery (VBAT)."
		(exclude_from_sim no)
		(at 20.32 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "50872643-d193-51dc-abf8-a6dc5cda3c5b")
	)
